---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="खोज">
  <section class="section">
    <div class="container">
      <div class="section-header text-center">
        <h2>🔍 खोज</h2>
        <p>दुर्गा सप्तशती में कुछ खोजें</p>
      </div>
      
      <div class="search-wrapper">
        <input 
          type="text" 
          id="searchInput" 
          class="search-input" 
          placeholder="जैसे: दुर्गा, कवच, अध्याय 1..."
          autocomplete="off"
        />
        <div id="searchResults" class="search-results"></div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  // Load Pagefind
  let pagefind;
  
  async function loadPagefind() {
    try {
      const res = await fetch('/pagefind/pagefind.js');
      if (!res.ok) return;
      eval(await res.text());
      pagefind = await window.pagefind();
    } catch (e) {
      console.log('Search not available');
    }
  }
  
  const input = document.getElementById('searchInput');
  const results = document.getElementById('searchResults');
  
  let debounceTimer;
  input?.addEventListener('input', async (e) => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(async () => {
      const query = e.target.value.trim();
      
      if (query.length < 2) {
        results.innerHTML = '';
        return;
      }
      
      if (!pagefind) await loadPagefind();
      
      try {
        const search = await pagefind.search(query);
        if (!search.results.length) {
          results.innerHTML = '<p class="text-center" style="color: var(--color-gray-500); padding: var(--spacing-8);">कोई परिणाम नहीं मिला</p>';
          return;
        }
        
        let html = '';
        for (const result of search.results.slice(0, 15)) {
          const data = await result.data();
          html += `
            <a href="${data.url}" class="search-result">
              <h3>${data.meta.title}</h3>
              ${data.meta.description ? `<p>${data.meta.description}</p>` : ''}
              <div class="meta">${data.meta.category || ''}</div>
            </a>
          `;
        }
        results.innerHTML = html;
      } catch (e) {
        console.error('Search error:', e);
      }
    }, 300);
  });
</script>