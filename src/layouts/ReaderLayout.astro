---
import BaseLayout from './BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import ReaderToolbar from '../components/ReaderToolbar.astro';

export interface Props {
  title: string;
  description?: string;
  keywords?: string[];
  section?: 'before-reading' | 'chapters' | 'after-reading' | 'articles';
  navItems?: any[];
}

const { title, description, keywords, section, navItems = [] } = Astro.props;
---

<BaseLayout {title} {description} {keywords}>
  <div class="reader-layout">
    <!-- Left Sidebar - Full Book Navigation -->
    <aside class="reader-sidebar">
      <Navigation items={navItems} currentSection={section} />
    </aside>
    
    <!-- Center - Reading Content -->
    <article class="reader-content">
      <div class="reader-header">
        <span class="chapter-label">
          {section === 'chapters' ? '📖 अध्याय' : 
           section === 'before-reading' ? '📚 पढ़ने से पहले' :
           section === 'after-reading' ? '🙏 पढ़ने के बाद' :
           section === 'articles' ? '📝 लेख' : ''}
        </span>
        <h1>{title}</h1>
        {description && <p class="description">{description}</p>}
      </div>
      
      <div class="prose">
        <slot />
      </div>
      
      <!-- Previous / Next Navigation -->
      <slot name="nav" />
    </article>
    
    <!-- Right Sidebar - Table of Contents -->
    <aside class="reader-toc">
      <div class="toc-sticky">
        <h4>📑 इस पृष्ठ में</h4>
        <ul class="toc-list" id="tocList">
          <!-- Auto-generated by JavaScript -->
        </ul>
      </div>
    </aside>
  </div>
  
  <ReaderToolbar />
</BaseLayout>

<script is:inline>
  // Auto-generate Table of Contents from headings
  document.addEventListener('DOMContentLoaded', function() {
    const tocList = document.getElementById('tocList');
    if (!tocList) return;
    
    const headings = document.querySelectorAll('.prose h2, .prose h3, .prose h4');
    if (!headings.length) {
      tocList.innerHTML = '<li style="color: var(--text-muted); font-size: var(--font-size-small); padding: var(--space-2);">कोई अनुभाग नहीं</li>';
      return;
    }
    
    headings.forEach(heading => {
      const level = heading.tagName.toLowerCase();
      const text = heading.textContent || '';
      const id = heading.id || text.toLowerCase().replace(/[^a-z0-9-]/g, '-');
      
      if (!heading.id) heading.id = id;
      
      const li = document.createElement('li');
      li.className = `toc-${level}`;
      
      const a = document.createElement('a');
      a.href = `#${id}`;
      a.textContent = text;
      a.setAttribute('data-target', id);
      
      li.appendChild(a);
      tocList.appendChild(li);
    });
    
    // Highlight active heading on scroll (Scroll Spy)
    const headingsArray = Array.from(headings);
    const tocLinks = tocList.querySelectorAll('a');
    
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          tocLinks.forEach(link => {
            link.classList.toggle('active', link.getAttribute('data-target') === id);
          });
        }
      });
    }, { 
      rootMargin: '-20% 0px -60% 0px',
      threshold: 0.1
    });
    
    headingsArray.forEach(h => observer.observe(h));
  });
</script>
