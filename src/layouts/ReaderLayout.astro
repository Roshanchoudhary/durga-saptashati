---
import BaseLayout from './BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import ReaderToolbar from '../components/ReaderToolbar.astro';

export interface Props {
  title: string;
  description?: string;
  keywords?: string[];
  section?: 'before-reading' | 'chapters' | 'after-reading' | 'articles';
  navItems?: any[];
}

const { title, description, keywords, section, navItems = [] } = Astro.props;
---

<BaseLayout {title} {description} {keywords}>
  <div class="reader-layout">
    <!-- Left Sidebar -->
    <aside class="reader-sidebar">
      <Navigation items={navItems} currentSection={section} />
    </aside>
    
    <!-- Main Content -->
    <article class="reader-content">
      <div class="reader-header">
        <h1>{title}</h1>
        {description && <p class="description">{description}</p>}
      </div>
      
      <div class="prose">
        <slot />
      </div>
      
      <!-- Navigation -->
      <slot name="nav" />
    </article>
    
    <!-- Right TOC -->
    <aside class="reader-toc">
      <div class="toc-sticky">
        <h4>इस पृष्ठ में</h4>
        <ul class="toc-list" id="tocList">
          <!-- Auto-generated by script -->
        </ul>
      </div>
    </aside>
  </div>
  
  <ReaderToolbar />
</BaseLayout>

<script>
  // Auto-generate TOC from headings
  document.addEventListener('DOMContentLoaded', () => {
    const tocList = document.getElementById('tocList');
    if (!tocList) return;
    
    const headings = document.querySelectorAll('.prose h2, .prose h3, .prose h4');
    if (!headings.length) {
      tocList.innerHTML = '<li>कोई अनुभाग नहीं</li>';
      return;
    }
    
    headings.forEach(heading => {
      const level = heading.tagName.toLowerCase();
      const text = heading.textContent || '';
      const id = heading.id || text.toLowerCase().replace(/[^a-z0-9-]/g, '-');
      
      if (!heading.id) heading.id = id;
      
      const li = document.createElement('li');
      li.className = `toc-${level}`;
      
      const a = document.createElement('a');
      a.href = `#${id}`;
      a.textContent = text;
      
      li.appendChild(a);
      tocList.appendChild(li);
    });
    
    // Highlight active heading on scroll
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          document.querySelectorAll('.toc-list a').forEach(a => {
            a.classList.toggle('active', a.getAttribute('href') === `#${id}`);
          });
        }
      });
    }, { rootMargin: '-20% 0px -70% 0px' });
    
    headings.forEach(h => observer.observe(h));
  });
</script>